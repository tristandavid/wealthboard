# Copy this file to keystore.properties (same folder, project root) and fill
# in the real values. keystore.properties is gitignored — never commit your
# actual keystore path/passwords, and never commit the .jks/.keystore file
# itself.
#
# Don't have a keystore yet? Generate one with the JDK's keytool (this is a
# one-time step; keep the resulting file and these passwords somewhere safe —
# see the "Play Store / release signing" section in README.md for what
# happens if you lose them):
#
#   keytool -genkeypair -v -keystore wealthboard-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias wealthboard
#
# Then point storeFile below at wherever you put that .jks file (an absolute
# path, or a path relative to the project root).

storeFile=../wealthboard-release.jks
storePassword=CHANGE_ME
keyAlias=wealthboard
keyPassword=CHANGE_ME
