<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Alerts. Android 13+ only; on older releases notifications are allowed
         by default and this is ignored. Requested at runtime from the Alerts
         screen rather than at launch, so the prompt arrives when the user has
         just asked to be notified about something and the "why" is obvious. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.WealthBoard"
        android:networkSecurityConfig="@xml/network_security_config">

        <!--
            The ACTIVITY label is what the home screen and app drawer show, and
            it overrides the application label. Kept short so the icon caption
            is not truncated to "WealthBoard:…"; the full product name stays on
            the application element, which is what the Settings > Apps list and
            the system share sheet use.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_launcher_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.WealthBoard.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Hands generated PDF reports to the system share sheet as content://
            URIs. Required since Android 7 (N), which forbids passing file://
            URIs to another app.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
